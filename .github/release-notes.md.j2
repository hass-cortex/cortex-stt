{#- GitHub release body: one section per change type, no version heading. -#}
{#- A "type!:" commit is listed under Breaking Changes, not its own type. -#}
{% macro render(changes) %}
{% for change in changes %}
{% if change.scope %}
- **{{ change.scope }}**: {{ change.message }}
{% elif change.message %}
- {{ change.message }}
{% endif %}
{% endfor %}
{% endmacro %}
{% for entry in tree %}
{% set breaking = entry.changes.get("Breaking Changes", []) | list %}
{% for change_key, changes in entry.changes.items() %}
{% if change_key != "Breaking Changes" %}
{% for change in changes if change.breaking %}{% set _ = breaking.append(change) %}{% endfor %}
{% endif %}
{% endfor %}
{% if breaking %}

## Breaking Changes

{{ render(breaking) }}
{% endif %}
{% for change_key, changes in entry.changes.items() %}
{% set kept = changes | rejectattr("breaking") | list %}
{% if change_key != "Breaking Changes" and kept %}

## {{ change_key }}

{{ render(kept) }}
{% endif %}
{% endfor %}
{% endfor %}
